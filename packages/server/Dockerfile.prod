# 本番 server イメージ。
# 開発（tsx で TS 直接実行）と異なり、esbuild で server + 依存（shared/database）を
# 単一 ESM ファイルにバンドルして実行する。参考: ~/sources/seseraki, girls-side-analysis。
# sharp だけはネイティブのためバンドル不可 → external にし、runtime で実体を導入する。
# 対象アーキ: linux/amd64（GitHub Actions でビルド。sharp のプリビルドバイナリもこの arch）。
#
# 実行イメージは distroless（Node と最小限の OS のパッケージだけ。npm もシェルも持たない）。
# ほかの server と同じく Debian 13（trixie）・Node 24 に揃える。
# ⚠ `node:24-slim` は Debian 12（bookworm）を指すので、build は `-trixie-slim` と系統を名指しする。

# ---- build: 依存解決 + esbuild バンドル -------------------------------------------------
FROM node:24-trixie-slim AS build
WORKDIR /workspace
RUN corepack enable

# マニフェスト類を先にコピー（ソース変更でレイヤキャッシュを壊さない）。
# catalog: 参照の解決に pnpm-workspace.yaml が必須（無いと ERR_PNPM_CATALOG_ENTRY_NOT_FOUND）。
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared/package.json   packages/shared/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/server/package.json   packages/server/package.json
COPY packages/web/package.json      packages/web/package.json
COPY packages/worker/package.json   packages/worker/package.json
# pnpm の prepare フック（.githooks/install.sh）が install 時に呼ばれる。
# git 管理外では自身で exit 0 するが、ファイルが無いと sh が開けず落ちるため先にコピーする。
COPY .githooks .githooks

# server とその依存（shared/database）だけを解決する（web/worker の重い依存は入れない）。
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter server...

# バンドル対象のソース。
COPY packages/shared   packages/shared
COPY packages/database packages/database
COPY packages/server   packages/server

RUN pnpm --filter server build   # → packages/server/dist/server.js（sharp は external）

# migrate / seed のエントリ（→ packages/database/dist/{migrate,seed}.js）。
# **同じイメージに同梱する**理由は、適用する SQL / カタログとコードのバージョンが
# 構造的に一致すること（外部から流す方式は、両者がずれても何も警告されない）。
RUN pnpm --filter database build

# sharp（バンドルできないネイティブ依存）を、上の frozen install が置いた実体から取り出す
# ＝ commit 済み pnpm-lock.yaml と minimumReleaseAge を尊重する（prd/02 §6）。
# pnpm の仮想ストアでは、パッケージの依存は `.pnpm/<pkg>/node_modules/` に兄弟として並ぶので、
# そこを実体化（-L）してコピーすれば sharp のクロージャになる。peer の違いで sharp の実体が
# 複数できたときは、どれを取るか決められないので止める。
RUN set -eu; \
    set -- node_modules/.pnpm/sharp@*/node_modules; \
    if [ "$#" -ne 1 ]; then echo "sharp の実体が 1 つではない: $*" >&2; exit 1; fi; \
    mkdir -p /deploy && cp -rL "$1" /deploy/node_modules

# server.js / migrate.js / seed.js は ESM（.js）。Node に ESM と認識させるため type=module を置く。
# runtime（distroless）にはシェルが無く RUN が打てないので、ここで作って COPY する。
RUN printf '{"private":true,"type":"module"}\n' > /deploy/package.json

# ---- runtime: バンドル + sharp のクロージャのみ ----------------------------------------
# distroless の root 版（`:latest`）。node:24-slim と同じく root で動かす（実行ユーザーは変えない）。
FROM gcr.io/distroless/nodejs24-debian13:latest AS runtime
WORKDIR /app
ENV NODE_ENV=production

# 🔒 **起動の仕方を node:24-slim のときと同じに保つ**（ENTRYPOINT を持たず、command は `node` から書く）。
# distroless の既定は ENTRYPOINT=/nodejs/bin/node で、そのままだと compose の
# `command: ["node", "/app/migrate.js"]` が `node node /app/migrate.js` になって落ちる。
# 本番の compose を書き換えずに済むよう、ENTRYPOINT を空にし、`node` を PATH で引けるようにする。
# （distroless の PATH には /nodejs/bin が無い。）src/lib/__tests__/dockerfile-runtime.test.ts が照合する。
ENV PATH=/nodejs/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENTRYPOINT []

COPY --from=build /deploy/package.json ./package.json
COPY --from=build /workspace/packages/server/dist/server.js ./server.js

# sharp の実行時クロージャ（lockfile 固定の実体）を build stage からコピーする。
# sharp 0.35.x の依存 = sharp 本体 + native @img/* + detect-libc + semver（後2つは依存ゼロ）。
# 存在しないパスの COPY は build を失敗させるため、sharp 更新で依存が変わればここで検知できる。
COPY --from=build /deploy/node_modules/sharp       ./node_modules/sharp
COPY --from=build /deploy/node_modules/@img        ./node_modules/@img
COPY --from=build /deploy/node_modules/detect-libc ./node_modules/detect-libc
COPY --from=build /deploy/node_modules/semver      ./node_modules/semver

# migrate / seed のエントリ。**使い捨てコンテナとして明示的に実行する**（起動時の自動適用に
# はしない——失敗時の挙動と、将来インスタンスを増やしたときの競合が読めなくなるため）。
#
#   docker compose run --rm <migrate service>   # command: ["node", "/app/migrate.js"]
#   docker compose run --rm <seed service>      # command: ["node", "/app/seed.js"]
#
# ⚠ ENTRYPOINT を持たない（CMD が `node server.js`。上の ENTRYPOINT [] を参照）ので、
#   compose の command は **`node` から書く**。パスだけ渡す形（`["/app/migrate.js"]`）は通らない。
# ⚠ distroless には**シェルが無い**。`docker compose exec <service> sh` は使えない。
COPY --from=build /workspace/packages/database/dist/migrate.js ./migrate.js
COPY --from=build /workspace/packages/database/dist/seed.js    ./seed.js

# 生成済みの SQL。**バンドルには含まれない**（migrator が実行時に fs で読むため）。
# ⚠ ここを忘れると、マイグレーションを流すまで気づけない。
COPY --from=build /workspace/packages/database/drizzle ./drizzle

# ビルドの版（prd/02 §9.3）。`GET /api/version` が返す。`.dockerignore` が `.git` を除くので
# イメージの中では git から取れない——ビルド引数で渡す。未指定なら unknown（ビルドは止めない）。
#   --build-arg GIT_COMMIT=$(git rev-parse HEAD)
#   --build-arg BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ)
#   --build-arg GIT_DIRTY=$(test -z "$(git status --porcelain --untracked-files=no)" && echo false || echo true)
# 最終ステージの末尾に置く（値が毎回変わるので、手前の層のキャッシュを壊さないように）。
# 渡し忘れは src/lib/__tests__/build-version.test.ts が照合する。
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
ARG GIT_DIRTY=false
ENV GIT_COMMIT=$GIT_COMMIT BUILD_TIME=$BUILD_TIME GIT_DIRTY=$GIT_DIRTY

EXPOSE 4000
CMD ["node", "server.js"]
